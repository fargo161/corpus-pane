{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprite-foundry.local/schemas/corpus-pane-view-state-v1.json",
  "title": "Corpus Pane proposed split view state",
  "type": "object",
  "required": [
    "body",
    "head"
  ],
  "properties": {
    "body": {
      "$ref": "#/$defs/orientation"
    },
    "head": {
      "$ref": "#/$defs/orientation"
    },
    "regionOverrides": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/orientation"
      }
    }
  },
  "$defs": {
    "orientation": {
      "type": "object",
      "required": [
        "family",
        "heading",
        "status"
      ],
      "properties": {
        "family": {
          "enum": [
            "FRONT",
            "FRONT_THREE_QUARTER",
            "PROFILE",
            "BACK_THREE_QUARTER",
            "BACK",
            "MIXED",
            "UNKNOWN"
          ]
        },
        "heading": {
          "enum": [
            "toward",
            "image_left",
            "image_right",
            "away",
            "mixed",
            "unknown"
          ]
        },
        "status": {
          "enum": [
            "provisional",
            "reviewed",
            "owner_verified",
            "mixed",
            "unknown"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
