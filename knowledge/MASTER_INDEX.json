  "adoptionOrder": [
    {
      "stage": 1,
      "name": "Metadata-only adoption",
      "action": "Use view split, projection state, source/provenance and article IDs without changing trackers."
    },
    {
      "stage": 2,
      "name": "Reference retrieval upgrade",
      "action": "Add pose signatures and view-aware ranking; no automatic coordinate transfer."
    },
    {
      "stage": 3,
      "name": "Controlled perspective pilot",
      "action": "Generate a small external arm–shoulder–torso reference pack and A/B test it on unseen mannequin video."
    },
    {
      "stage": 4,
      "name": "Poser bridge pilot",
      "action": "Map one or two reviewed configurations into the still mannequin and run part compatibility/articulation tests."
    },
    {
      "stage": 5,
      "name": "Expand by demonstrated gaps",
      "action": "Add legs, head/neck, torso/pelvis and selected external motion only when tests show value."
    }
  ],
  "updatePolicy": {
    "articleIdsStable": true,
    "noSilentSemanticChanges": true,
    "unknownFieldsPreserved": true,
    "newKnowledgeRule": "Add or version articles and schemas; do not rewrite source evidence or owner-approved decisions to fit new theory.",
    "skeletonChangeRule": "A suspected limitation must be investigated and migrated explicitly; perspective metadata should be extended before changing universal joint identity."
  }
}