{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus-pane.invalid/proposals/records-1.0.0",
  "title": "Preflight record design proposal (not full production schema)",
  "$comment": "Nested schema completion and cross-record invariants are M01 work. No application implementation is included.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "type": {
      "enum": [
        "SourceAsset",
        "FrameObservation",
        "PersonIdentity",
        "ComponentIdentity",
        "RawProviderObservation",
        "EvidenceMapping",
        "ComponentTrack",
        "SpatialEvidence",
        "CanonicalSurface",
        "Registration",
        "AnatomicalBinding",
        "ArtworkPivot",
        "AttachmentSocket",
        "Mesh",
        "LayeredAssetPackage",
        "HeadIdentity",
        "FaceKit",
        "FamilyProfile",
        "CharacterPackage",
        "AnchorBinding",
        "RolePerformance",
        "PairedActionTemplate",
        "RelationshipChannel",
        "ReviewEvent",
        "CompatibilityTestRun",
        "JobRecord",
        "MigrationRecord",
        "CalibrationRecord",
        "BodyPackage",
        "DerivationProcess",
        "RightsRecord",
        "ContributorTable",
        "PoserProfile",
        "ArtworkRigMapping"
      ]
    },
    "entityId": {
      "$ref": "#/$defs/uuid"
    },
    "revisionId": {
      "$ref": "#/$defs/uuid"
    },
    "parentRevisionIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/uuid"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "actorId": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "derivedFrom": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uuid"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "type",
    "entityId",
    "revisionId",
    "parentRevisionIds",
    "createdAt",
    "actorId",
    "payload",
    "derivedFrom",
    "extensions"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "SourceAsset"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "containerSha256",
              "byteLength",
              "MIME",
              "sourceRightsRef",
              "streams",
              "decoderIdentity",
              "originalName"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "FrameObservation"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "frameRef",
              "blobRefs",
              "transforms",
              "sourceViewMetadata"
            ],
            "properties": {
              "frameRef": {
                "$ref": "#/$defs/FrameRef"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "PersonIdentity"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
