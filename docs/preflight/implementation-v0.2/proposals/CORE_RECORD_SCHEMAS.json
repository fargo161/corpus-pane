          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "personEntityId",
              "semanticClass",
              "regionCodes",
              "associationRefs"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "RawProviderObservation"
          }
        },
        "required": [
          "type"
        ]
      },
