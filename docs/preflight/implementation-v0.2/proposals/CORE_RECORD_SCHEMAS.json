  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "FrameRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSha256",
        "streamIndex",
        "decodeIndex",
        "ptsTicks",
        "timeBaseNum",
        "timeBaseDen",
        "pixelSha256",
        "width",
        "height",
        "decoderIdentity"
      ],
      "properties": {
        "sourceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "streamIndex": {
          "type": "integer",
          "minimum": 0
        },
        "decodeIndex": {
          "type": "integer",
          "minimum": 0
        },
        "ptsTicks": {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        },
        "timeBaseNum": {
          "type": "integer",
          "minimum": 1
        },
        "timeBaseDen": {
          "type": "integer",
          "minimum": 1
        },
        "pixelSha256": {
          "$ref": "#/$defs/sha256"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "decoderIdentity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "BlobRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "byteLength",
        "mime"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "mime": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SpatialEvidence": {
      "type": "object",
      "required": [
        "width",
        "height",
        "referenceObservationRef",
        "coverageBlob",
        "originBlob",
        "contributorIndexBlob",
        "contributorTableRef",
        "uncertaintyBlob"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "referenceObservationRef": {
          "$ref": "#/$defs/uuid"
        },
        "coverageBlob": {
          "$ref": "#/$defs/BlobRef"
        },
        "originBlob": {
          "$ref": "#/$defs/BlobRef"
        },
        "contributorIndexBlob": {
          "$ref": "#/$defs/BlobRef"
        },
        "uncertaintyBlob": {
          "$ref": "#/$defs/BlobRef"
        },
        "contributorTableRef": {
          "$ref": "#/$defs/uuid"
        }
      },
      "additionalProperties": false
    },
    "FaceSlots": {
      "type": "object",
      "required": [
        "LEFT_BROW",
        "RIGHT_BROW",
        "LEFT_EYE",
        "RIGHT_EYE",
        "LOWER_FACE"
      ],
      "properties": {
        "LEFT_BROW": {
          "type": "object",
          "required": [
