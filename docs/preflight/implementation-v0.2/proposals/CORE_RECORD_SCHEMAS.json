              "rawObservationRefs",
              "mappingVersion",
              "skeletonId",
              "skeletonVersion",
              "landmarkMap",
              "sideViewAssumptions",
              "residuals"
            ],
            "properties": {
              "skeletonVersion": {
                "const": "1.2.0"
              },
              "skeletonId": {
                "const": "adventure-studio/universal-skeleton"
              }
            }
          }
        }
      }
    },
    {
      "if": {
